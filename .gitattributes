* text=auto

# Files executed on Linux must retain Unix line endings on Windows checkouts.
*.sh text eol=lf
*.service text eol=lf

# Maintainer and generated files are useful in Git but not in release archives.
/.agents export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/CODEX_REVIEW.md export-ignore
/TODO.md export-ignore
/testResults.xml export-ignore
