#!/usr/bin/env bash
# Symbolic Google Cloud CLI: never contacts Google Cloud.
set -euo pipefail
args="$*"; state="${CLAUDIT_GCP_FIXTURE:-healthy}"
if [[ "$args" == *"asset search-all-resources"* ]]; then
    printf '%s\n' '[{"name":"//fixture/resource/one"}]'
elif [[ "$args" == *"projects describe"* ]]; then
    case "$state" in healthy|insecure) printf '%s\n' '{"projectId":"fixture","projectNumber":"123456789012"}' ;; malformed) printf '%s\n' '{}' ;; denied) exit 1 ;; *) exit 64 ;; esac
elif [[ "$args" == *"logging sinks list"* ]]; then
    case "$state" in healthy) printf '%s\n' '[{"name":"central","destination":"storage.googleapis.com/audit-logs","disabled":false}]' ;; insecure) printf '%s\n' '[{"name":"_Default","destination":"logging.googleapis.com/projects/fixture/locations/global/buckets/_Default","disabled":false}]' ;; malformed) printf '%s\n' '{}' ;; denied) exit 1 ;; *) exit 64 ;; esac
elif [[ "$args" == *"projects get-iam-policy"* ]]; then
    case "$state" in healthy) printf '%s\n' '{"bindings":[],"auditConfigs":[{"service":"allServices","auditLogConfigs":[{"logType":"DATA_READ"},{"logType":"DATA_WRITE"}]}]}' ;; insecure) printf '%s\n' '{"bindings":[{"role":"roles/owner","members":["user:unapproved@example.com"]}],"auditConfigs":[]}' ;; malformed) printf '%s\n' '{"bindings":{},"auditConfigs":{}}' ;; denied) exit 1 ;; *) exit 64 ;; esac
elif [[ "$args" == *"compute project-info describe"* ]]; then
    case "$state" in healthy) printf '%s\n' '{"commonInstanceMetadata":{"items":[{"key":"enable-oslogin","value":"TRUE"}]}}' ;; insecure) printf '%s\n' '{"commonInstanceMetadata":{"items":[]}}' ;; malformed) printf '%s\n' '{"commonInstanceMetadata":{}}' ;; denied) exit 1 ;; *) exit 64 ;; esac
elif [[ "$args" == *"iam service-accounts list"* ]]; then
    case "$state" in healthy|insecure) printf '%s\n' '[{"email":"audit@fixture.iam.gserviceaccount.com"}]' ;; malformed) printf '%s\n' '[{"email":1}]' ;; denied) exit 1 ;; *) exit 64 ;; esac
elif [[ "$args" == *"iam service-accounts keys list"* ]]; then
    if [[ "$state" == insecure ]]; then created="$(date -u -d '400 days ago' +%Y-%m-%dT%H:%M:%SZ)"
    else created="$(date -u -d '30 days ago' +%Y-%m-%dT%H:%M:%SZ)"; fi
    printf '[{"validAfterTime":"%s","disabled":false}]\n' "$created"
else exit 64; fi
